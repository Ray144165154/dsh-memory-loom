{
    "name":  "dsh-memory-loom",
    "version":  "0.1.8",
    "description":  "Long-term cross-session memory and association for DeepSeek Harness: durable memory records, activation-spreading recall, and automatic prompt injection.",
    "type":  "module",
    "main":  "index.js",
    "exports":  {
                    ".":  "./index.js",
                    "./client":  "./client.js",
                    "./package.json":  "./package.json",
                    "./cordis.patch.yml":  "./cordis.patch.yml"
                },
    "files":  [
                  "index.js",
                  "client.js",
                  "lib",
                  "cordis.patch.yml",
                  "README.md",
                  "LICENSE"
              ],
    "license":  "MIT",
    "engines":  {
                    "node":  "\u003e=22.19",
                    "dsh":  "\u003e=0.1.5-rc.2"
                },
    "keywords":  [
                     "dsh-plugin",
                     "deepseek-harness",
                     "dsh",
                     "cordis",
                     "memory",
                     "long-term-memory",
                     "cross-session"
                 ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "inject":  [
                                              "@deepseek-ai/dsh-client-locale",
                                              "@deepseek-ai/dsh-client-ui-settings-plugins"
                                          ]
                           }
            },
    "dependencies":  {
                         "zod":  "^4.6.1"
                     },
    "peerDependencies":  {
                             "@deepseek-ai/cordis":  "^4.0.2",
                             "@deepseek-ai/dsh-session":  "\u003e=0.1.5-rc.2",
                             "@deepseek-ai/dsh-storage-domain":  "\u003e=0.1.5-rc.2",
                             "@deepseek-ai/dsh-system-prompt":  "\u003e=0.1.5-rc.2",
                             "@deepseek-ai/dsh-tools":  "\u003e=0.1.5-rc.2",
                             "@deepseek-ai/schemastery":  "^3.18.2"
                         },
    "author":  "Ray144165154 \u003c239973946@qq.com\u003e",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/Ray144165154/dsh-memory-loom.git"
                   },
    "bugs":  {
                 "url":  "https://github.com/Ray144165154/dsh-memory-loom/issues"
             },
    "homepage":  "https://github.com/Ray144165154/dsh-memory-loom#readme",
    "publishConfig":  {
                          "access":  "public"
                      }
}